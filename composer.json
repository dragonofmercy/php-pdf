{
    "name": "dragonofmercy/phppdf",
    "description": "Modern PHP library for PDF generation.",
    "type": "library",
    "license": "MIT",
    "keywords": ["pdf", "pdf-generation", "pdf-writer"],
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-zlib": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "symfony/process": "^7.0"
    },
    "suggest": {
        "ext-gd": "Decode JPEG images that appear inside an SVG <filter> region",
        "ext-curl": "Faster CRL and timestamp fetching for LTV; file_get_contents is used otherwise"
    },
    "autoload": {
        "psr-4": { "DragonOfMercy\\PhpPdf\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "DragonOfMercy\\PhpPdf\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "check": ["@analyse", "@test"]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
