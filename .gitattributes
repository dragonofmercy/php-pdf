# PDF golden fixtures are byte-identity contracts. They must never be passed
# through line-ending normalization (core.autocrlf) - doing so corrupts the
# bytes on checkout and breaks the byte-compare tests. Treat all PDFs as binary.
*.pdf binary
resources/icc/*.icc binary

# AFM font-metric sources carry CRLF line endings and are the exact byte source
# the committed src/Font/Metrics tables are generated from; never normalize them.
bin/afm-source/*.afm -text

# Dev-only assets kept out of the Composer dist archive (composer require uses
# the dist tarball, which honours export-ignore). src/, resources/ (runtime ICC
# profile), composer.json, LICENSE, README.md and CHANGELOG.md ship; everything
# else here is development tooling and stays out.
/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/bin export-ignore
/examples export-ignore
/tests export-ignore
/composer.lock export-ignore
/phpstan.neon export-ignore
/phpunit.xml export-ignore
